# Copy this file to .env.local and fill in your values

# Dashboard shared password — all team members use this to log in
DASHBOARD_PASSWORD=your-team-password-here

# Turso database (https://turso.tech)
# Run: turso db create content-planner && turso db show content-planner --url
TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io

# Run: turso db tokens create content-planner
TURSO_AUTH_TOKEN=your-turso-auth-token

# Internal signing secret for session cookies (any 32+ char random string)
SESSION_SECRET=change-me-to-a-32-char-secret!!
